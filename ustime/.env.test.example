# Copia este archivo a ".env.test" para el modo de pruebas (NUNCA se usa en producción).
VITE_TEST_MODE=true
# true = usa el emulador local de Firebase (cuentas y datos 100% falsos, sin tocar tu proyecto real)
VITE_USE_EMULATOR=true
# Con el emulador sirven valores inventados:
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-ustime
VITE_FIREBASE_APP_ID=demo-app
VITE_TMDB_KEY=
VITE_REGION=PE
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
